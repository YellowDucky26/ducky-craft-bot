# Verplicht
DISCORD_TOKEN=CHANGE_ME
GUILD_ID=CHANGE_ME
JELLYSEERR_URL=http://192.168.1.10:5055
JELLYSEERR_API_KEY=CHANGE_ME
# Moet overeenkomen met de "Authorization Header" van de Jellyseerr-webhook
# (en met de header van andere diensten die /notify gebruiken). Bv.: openssl rand -hex 24
WEBHOOK_SECRET=CHANGE_ME

# Optioneel: publieke URL's voor links in berichten (standaard gelijk aan de interne URL)
JELLYSEERR_PUBLIC_URL=
JELLYFIN_PUBLIC_URL=

# Optioneel: nodig voor /invite jellyfin
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Rollen (komma-gescheiden ID's). Leden met "Server beheren" zijn altijd admin.
ADMIN_ROLE_IDS=
INVITE_ROLE_IDS=
# Rol die iemand krijgt na /invite jellyfin
MEMBER_ROLE_ID=

# Kanalen
REQUEST_CHANNEL_ID=
ADMIN_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=
INVITE_CHANNEL_ID=

WEB_PORT=8688
DATA_DIR=/var/lib/ducky-craft-bot
LOG_LEVEL=INFO
