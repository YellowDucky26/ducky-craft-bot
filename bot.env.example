# Verplicht
DISCORD_TOKEN=CHANGE_ME
GUILD_ID=CHANGE_ME
JELLYSEERR_URL=http://192.168.1.10:5055
JELLYSEERR_API_KEY=CHANGE_ME
# Moet overeenkomen met de "Authorization Header" van de Jellyseerr-webhook
# (en met de header van andere diensten die /notify gebruiken). Bv.: openssl rand -hex 24
WEBHOOK_SECRET=CHANGE_ME

# Optioneel: publieke URL's voor links in berichten (standaard gelijk aan de interne URL)
JELLYSEERR_PUBLIC_URL=
JELLYFIN_PUBLIC_URL=

# Optioneel: nodig voor /invite jellyfin
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Rollen (komma-gescheiden ID's). Leden met "Server beheren" zijn altijd admin.
ADMIN_ROLE_IDS=
INVITE_ROLE_IDS=
# Rol die iemand krijgt na /invite jellyfin
MEMBER_ROLE_ID=

# Kanalen
REQUEST_CHANNEL_ID=
ADMIN_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=
INVITE_CHANNEL_ID=

# Geplande berichten
TZ=Europe/Amsterdam
# Tijdstip (HH:MM) van het overzicht van nieuwe titels en het maandoverzicht
REPORT_TIME=18:00
# Overzicht van nieuwe titels in Jellyfin: daily, weekly of off
DIGEST=weekly
# Bij weekly: de weekdag (maandag ... zondag)
DIGEST_DAY=vrijdag
# Kanaal voor dat overzicht (standaard ANNOUNCE_CHANNEL_ID)
DIGEST_CHANNEL_ID=
# Maandoverzicht (op de 1e) van Jellyfin-accounts die zo lang niets hebben gekeken; 0 = uit
INACTIVE_DAYS=60

WEB_PORT=8688
DATA_DIR=/var/lib/ducky-craft-bot
LOG_LEVEL=INFO
